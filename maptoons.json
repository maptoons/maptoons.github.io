{
	"version": 8,
	"name": "osm",
	"metadata": {
		"maputnik:renderer": "mbgljs"
	},
	"glyphs": "assets/fonts/{fontstack}/{range}.pbf",
	"sprite": [
		{"id": "sprites", "url": "https://maptoons.github.io/assets/sprites/sprites"},
		{"id": "maptoons-sprites", "url": "https://maptoons.github.io/assets/sprites/maptoons-sprites"},
		{"id": "railroad-sprites", "url": "http://localhost:5500/assets/sprites/railroad-sprites"}
	],
	"sources": {
		"osm": {
			"type": "vector",
			"url": "https://vector.openstreetmap.org/shortbread_v1/tilejson.json"
		}
	},
	"layers": [
		{
			"id": "background",
			"type": "background",
			"paint": {
				"background-color": "hsl(90, 29%, 70%)"
			}
		},
		{
			"source": "osm",
			"id": "ocean",
			"type": "fill",
			"source-layer": "ocean",
			"paint": {
				"fill-color": "hsl(181, 45%, 80%)"
			}
		},
		{
			"source": "osm",
			"id": "waterways-fill",
			"type": "fill",
			"source-layer": "water_polygons",
			"filter": ["in", "kind", "river", "water", "reservoir", "basin", "dock", "canal"],
			"paint": {
				"fill-color": "hsl(181, 45%, 80%)"
			}
		},
		{
			"source": "osm",
			"id": "waterways-line",
			"type": "line",
			"source-layer": "water_lines",
			"filter": ["in", "kind", "canal", "river", "stream", "ditch"],
			"paint": {
				"line-color": "hsl(181, 45%, 80%)",
				"line-width": 4
			}
		},
		{
			"source": "osm",
			"id": "waterways-line-labels",
			"type": "symbol",
			"source-layer": "water_lines_labels",
			"filter": ["in", "kind", "canal", "river", "stream", "ditch"],
			"layout": {
				"text-field": "{name}",
				"text-transform": "uppercase",
				"text-font": [ "poppins-regular" ],
				"text-letter-spacing": 0.2,
				"symbol-placement": "line",
				"symbol-spacing": [ "interpolate", [ "linear" ], [ "zoom" ],   10, 100, 12, 200, 14, 350, 16, 500, 18, 800],
				"text-anchor": "center",
				"text-size": [ "interpolate", [ "exponential", 1.5 ], [ "zoom" ], 12, 10, 20, 30 ],
				"text-rotation-alignment": "map",
				"text-max-angle": 45
			},
			"paint": {
				"text-color": "hsl(0, 0%, 30%)",
				"text-opacity": [ "interpolate", [ "linear" ], [ "zoom" ], 11, 0, 12, 1 ]
			}
		},
		{
			"source": "osm",
			"id": "land-beach",
			"type": "fill",
			"source-layer": "land",
			"filter": [ "all", [ "in", "kind", "beach", "sand" ] ],
			"paint": {
				"fill-color": "hsl(39, 100%, 85%)"
			}
		},
		{
			"source": "osm",
			"id": "street",
			"type": "line",
			"source-layer": "streets",
			"filter": [ "in", "kind", "motorway", "trunk", "primary", "secondary", "tertiary", "residential" ],
			"paint": {
				"line-color": "hsl(54, 56%, 90%)",
				"line-width": [ "interpolate", [ "exponential", 2 ], [ "zoom" ], 11, 0, 20, 200 ]
			},
			"layout": {
				"line-join": "round",
				"line-cap": "round"
			},
			"minzoom": 11
		},
		{
			"source": "osm",
			"id": "waterways_fill_labels",
			"type": "symbol",
			"source-layer": "water_polygons_labels",
			"filter": ["in", "kind", "river", "water", "reservoir", "basin", "dock", "canal"],
			"layout": {
				"text-field": ["get", "name"],
				"text-size": 8,
				"text-font": [ "poppins-medium" ],
				"text-anchor": "center",
				"text-justify": "center",
				"symbol-placement": "point",
				"text-optional": true,
				"text-max-width": 8,
				"text-transform": "uppercase",
				"text-letter-spacing": 0.2
			},
			"paint": {
				"text-color": "hsl(0, 0%, 30%)",
				"text-opacity": [ "interpolate", [ "linear" ], [ "zoom" ], 13, 0, 14, 1 ]
			}
		},
		{
			"source": "osm",
			"id": "rail-road",
			"type": "line",
			"source-layer": "streets",
			"filter": ["in", "kind", "rail", "narrow_gauge", "light_rail", "funicular", "subway", "monorail"],
			"paint": {
				"line-color": "hsl(223, 11%, 12%)",
				"line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 16, 5, 18, 10],
				"line-pattern": "railroad-sprites:high-zoom",
				"line-opacity": ["step", ["zoom"], 0, 15, 0, 16, 1]
			},
			"minzoom": 13
		},
		{
			"source": "osm",
			"id": "rail-road-md-zoom",
			"type": "line",
			"source-layer": "streets",
			"filter": ["in", "kind", "rail", "narrow_gauge", "light_rail", "funicular", "subway", "monorail"],
			"paint": {
				"line-color": "hsl(223, 11%, 12%)",
				"line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 12, 5, 16, 10],
				"line-pattern": "railroad-sprites:mid-zoom",
				"line-opacity": ["step", ["zoom"], 0, 14, 0, 15, 0.8, 16, 0]
			},
			"minzoom": 13
		},
		{
			"source": "osm",
			"id": "rail-road-low-zoom",
			"type": "line",
			"source-layer": "streets",
			"filter": ["in", "kind", "rail", "narrow_gauge", "light_rail", "funicular", "subway", "monorail"],
			"paint": {
				"line-color": "hsl(223, 11%, 12%)",
				"line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 11, 5, 15, 8],
				"line-pattern": "railroad-sprites:low-zoom",
				"line-opacity": ["interpolate", ["exponential", 1.5], ["zoom"], 11, 0.1, 13, 0.5, 15, 1]
			},
			"minzoom": 11,
			"maxzoom": 15
		},
		{
			"source": "osm",
			"id": "label-street",
			"type": "symbol",
			"source-layer": "street_labels",
			"filter": [ "in", "kind", "motorway", "trunk", "primary", "secondary", "tertiary", "residential" ],
			"layout": {
				"text-field": "{name}",
				"text-transform": "uppercase",
				"text-font": [ "poppins-regular" ],
				"text-letter-spacing": 0.2,
				"symbol-placement": "line",
				"symbol-spacing": 400,
				"text-anchor": "center",
				"text-size": [ "interpolate", [ "exponential", 1.5 ], [ "zoom" ], 10, 5, 20, 30 ]
			},
			"paint": {
				"text-color": "hsl(0, 0%, 30%)",
				"text-opacity": [ "interpolate", [ "linear" ], [ "zoom" ], 11, 0, 12, 1 ]
			}
		},
		{
			"source": "osm",
			"id": "label-neighbourhood",
			"type": "symbol",
			"source-layer": "place_labels",
			"filter": [ "in", "kind", "neighbourhood", "quarter", "suburb" ],
			"layout": {
				"text-field": "{name}",
				"text-font": [ "poppins-medium" ],
				"text-letter-spacing": 0.1,
				"text-size": 10
			},
			"paint": {
				"text-color": "hsl(0, 0%, 30%)",
				"text-opacity": [ "interpolate", [ "linear" ], [ "zoom" ], 11, 1, 12, 0 ],
				"text-halo-color": "hsla(0, 0%, 100%, 0.5)",
				"text-halo-width": 0
			},
			"maxzoom": 12
		},
		{
			"source": "osm",
			"id": "label-city",
			"type": "symbol",
			"source-layer": "place_labels",
			"filter": [ "in", "kind", "city", "town", "village", "hamlet", "capital", "state_capital" ],
			"layout": {
				"text-field": "{name}",
				"text-font": [ "poppins-medium" ],
				"text-letter-spacing": 0.1,
				"text-size": 10
			},
			"paint": {
				"text-color": "hsl(0, 0%, 30%)",
				"text-opacity": [ "interpolate", [ "linear" ], [ "zoom" ], 11, 1, 12, 0 ],
				"text-halo-color": "hsla(0, 0%, 100%, 0.5)",
				"text-halo-width": 0
			},
			"maxzoom": 12
		},
		{
			"source": "osm",
			"id": "rail-stations",
			"type": "symbol",
			"source-layer": "public_transport",
			"filter": ["in", "kind", "station", "halt", "tram_stop"],
			"layout": {
				"icon-image": "railroad-sprites:lirr-sign",
				"icon-size": ["interpolate", ["exponential", 1.5], ["zoom"], 14, 0.2, 16, 0.45],
				"icon-allow-overlap": true,
				"icon-ignore-placement": true
			},
			"paint": {
				"icon-opacity": ["interpolate", ["linear"], ["zoom"], 13.75, 0, 14, 1]
			}
		},
		{
			"source": "osm",
			"id": "rail-stations-labels",
			"type": "symbol",
			"source-layer": "public_transport",
			"filter": ["in", "kind", "station", "halt", "tram_stop"],
			"layout": {
				"text-field": ["get", "name"],
				"text-font": [ "poppins-medium" ],
				"text-size": ["interpolate", ["exponential", 1.5], ["zoom"], 14, 6, 16, 11],
				"text-anchor": "center",
				"text-optional": true
			},
			"paint": {
				"text-color": "#222222",
				"text-opacity": ["interpolate", ["linear"], ["zoom"], 13.75, 0, 14, 1]
			}
		}
	]
}
