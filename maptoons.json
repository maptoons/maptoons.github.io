{
	"version": 8,
	"name": "osm",
	"metadata": {
		"maputnik:renderer": "mbgljs"
	},
	"glyphs": "assets/fonts/{fontstack}/{range}.pbf",
	"sprite": "https://maptoons.github.io/assets/sprites/sprites",
	"sources": {
		"long_island": {
			"type": "vector",
			"tiles": ["data/long_island/{z}/{x}/{y}.pbf"]
		},
		"long_island_highway": {
			"type": "vector",
			"tiles": ["data/long_island_highway/{z}/{x}/{y}.pbf"]
		}
	},
	"layers": [
		{
			"id": "background",
			"type": "background",
			"paint": {
				"background-color": "hsl(0, 0%, 100%)"
			}
		},
		{
			"source": "long_island",
			"id": "long-island",
			"type": "fill",
			"source-layer": "long_island",
			"paint": {
				"fill-color": "hsl(92, 46%, 72%)"
			}
		},
		{
			"source": "long_island_highway",
			"id": "street",
			"type": "line",
			"source-layer": "long_island_highway",
			"paint": {
				"line-color": "HSL(54, 56%, 90%)",
				"line-width": [ "interpolate", [ "exponential", 2 ], [ "zoom" ], 11, 0, 20, 200 ]
			},
			"layout": {
				"line-join": "round",
				"line-cap": "round"
			},
			"minzoom": 11
		},
		{
			"source": "long_island_highway",
			"id": "label-street",
			"type": "symbol",
			"source-layer": "long_island_highway",
			"layout": {
				"text-field": "{name}",
				"text-transform": "uppercase",
				"text-font": [ "poppins-regular" ],
				"text-letter-spacing": 0.2,
				"symbol-placement": "line",
				"symbol-spacing": 400,
				"text-anchor": "center",
				"text-size": [ "interpolate", [ "exponential", 1.5 ], [ "zoom" ], 10, 5, 20, 30 ]
			},
			"paint": {
				"text-color": "hsl(0, 0%, 30%)",
				"text-opacity": [ "interpolate", [ "linear" ], [ "zoom" ], 11, 0, 12, 1 ]
			}
		}
	]
}
